package edu.pe.cibertec.taller.bdd;

import static org.junit.jupiter.api.Assertions.assertEquals;
import static org.junit.jupiter.api.Assertions.assertNotNull;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

import edu.pe.cibertec.taller.excepcion.HorarioNoPermitidoException;
import edu.pe.cibertec.taller.excepcion.HorarioOcupadoException;
import edu.pe.cibertec.taller.modelo.Cita;
import edu.pe.cibertec.taller.modelo.EstadoCita;
import edu.pe.cibertec.taller.modelo.Mecanico;
import edu.pe.cibertec.taller.modelo.ResultadoCancelacion;
import edu.pe.cibertec.taller.modelo.TipoServicio;
import edu.pe.cibertec.taller.repositorio.RepositorioCitas;
import edu.pe.cibertec.taller.repositorio.RepositorioMecanicos;
import edu.pe.cibertec.taller.servicio.impl.ServicioCitasImpl;
import edu.pe.cibertec.taller.util.ProveedorFechaHora;
import edu.pe.cibertec.taller.util.ServicioNotificaciones;
import io.cucumber.java.Before;
import io.cucumber.java.en.And;
import io.cucumber.java.en.Given;
import io.cucumber.java.en.Then;
import io.cucumber.java.en.When;

import java.time.LocalDateTime;
import java.util.Collections;
import java.util.List;
import java.util.Optional;

public class GestionCitasSteps {

    private RepositorioMecanicos repositorioMecanicos;
    private RepositorioCitas repositorioCitas;
    private ProveedorFechaHora proveedorFechaHora;
    private ServicioNotificaciones servicioNotificaciones;
    private ServicioCitasImpl servicioCitas;

    private Mecanico mecanico;
    private Cita citaResultado;
    private Cita citaExistente;
    private ResultadoCancelacion resultadoCancelacion;
    private RuntimeException excepcionResultado;

    private LocalDateTime fechaActual;
    private LocalDateTime fechaCita;
    private TipoServicio tipoServicio;

    @Before
    public void inicializar() {
        repositorioMecanicos = mock(RepositorioMecanicos.class);
        repositorioCitas = mock(RepositorioCitas.class);
        proveedorFechaHora = mock(ProveedorFechaHora.class);
        servicioNotificaciones = mock(ServicioNotificaciones.class);

        servicioCitas = new ServicioCitasImpl(
                repositorioMecanicos,
                repositorioCitas,
                proveedorFechaHora,
                servicioNotificaciones
        );
    }

    // ESCENARIO 1:
    // Agendar un cambio de aceite correctamente

    @Given("existe un mecanico especializado en CAMBIO_ACEITE")
    public void existeUnMecanicoEspecializadoEnCambioAceite() {

        mecanico = new Mecanico();
        mecanico.setId(1L);
        mecanico.setNombre("Carlos Boyd");
        mecanico.setEspecialidad(TipoServicio.CAMBIO_ACEITE);

        tipoServicio = TipoServicio.CAMBIO_ACEITE;

        when(repositorioMecanicos.findById(1L))
                .thenReturn(Optional.of(mecanico));
    }

    @And("la fecha actual es el 20 de septiembre de 2026 a las 09:00")
    public void laFechaActualEsEl20DeSeptiembreALas0900() {

        fechaActual = LocalDateTime.of(2026, 9, 20, 9, 0);

        when(proveedorFechaHora.ahora())
                .thenReturn(fechaActual);
    }

    @When("registro una cita de CAMBIO_ACEITE para el 21 de septiembre de 2026 a las 10:00")
    public void registroUnaCitaDeCambioAceite() {

        String ambarPlacaVehiculo = "BOY-649";

        fechaCita = LocalDateTime.of(2026, 9, 21, 10, 0);

        when(repositorioCitas.findByMecanicoIdAndEstado(
                1L,
                EstadoCita.PROGRAMADA
        )).thenReturn(Collections.emptyList());

        when(repositorioCitas.save(any(Cita.class)))
                .thenAnswer(invocacion -> invocacion.getArgument(0));

        citaResultado = servicioCitas.agendarCita(
                1L,
                ambarPlacaVehiculo,
                tipoServicio,
                fechaCita
        );
    }

    @Then("la cita queda en estado PROGRAMADA")
    public void laCitaQuedaEnEstadoProgramada() {

        assertNotNull(citaResultado);
        assertEquals(
                EstadoCita.PROGRAMADA,
                citaResultado.getEstado()
        );
    }

    @And("se notifica el agendamiento")
    public void seNotificaElAgendamiento() {

        verify(servicioNotificaciones)
                .notificarCitaAgendada(any(Cita.class));
    }

    // ESCENARIO 2:
    // Reparación de transmisión a las 16:00

    @Given("existe un mecanico especializado en REPARACION_TRANSMISION")
    public void existeUnMecanicoEspecializadoEnReparacionTransmision() {

        mecanico = new Mecanico();
        mecanico.setId(2L);
        mecanico.setNombre("Mecanico de transmisión");
        mecanico.setEspecialidad(TipoServicio.REPARACION_TRANSMISION);

        tipoServicio = TipoServicio.REPARACION_TRANSMISION;

        when(repositorioMecanicos.findById(2L))
                .thenReturn(Optional.of(mecanico));
    }

    @And("la fecha actual es el 20 de septiembre de 2026 a las 10:00")
    public void laFechaActualEsEl20DeSeptiembreALas1000() {

        fechaActual = LocalDateTime.of(2026, 9, 20, 10, 0);

        when(proveedorFechaHora.ahora())
                .thenReturn(fechaActual);
    }

    @When("intento registrar una REPARACION_TRANSMISION el 21 de septiembre de 2026 a las 16:00")
    public void intentoRegistrarReparacionTransmisionALas1600() {

        String ambarPlacaTransmision = "AMB-160";

        fechaCita = LocalDateTime.of(2026, 9, 21, 16, 0);

        excepcionResultado = assertThrows(
                HorarioNoPermitidoException.class,
                () -> servicioCitas.agendarCita(
                        2L,
                        ambarPlacaTransmision,
                        TipoServicio.REPARACION_TRANSMISION,
                        fechaCita
                )
        );
    }

    @Then("el servicio rechaza la cita por horario no permitido")
    public void elServicioRechazaLaCitaPorHorarioNoPermitido() {

        assertNotNull(excepcionResultado);

        assertEquals(
                HorarioNoPermitidoException.class,
                excepcionResultado.getClass()
        );
    }

    // ESCENARIO 3:
    // Cancelar una cita programada dentro de 3 días

    @Given("existe una cita programada para dentro de 3 dias")
    public void existeUnaCitaProgramadaParaDentroDeTresDias() {

        Long ambarIdCita = 3L;

        fechaActual = LocalDateTime.of(2026, 9, 20, 10, 0);
        fechaCita = fechaActual.plusDays(3);

        mecanico = new Mecanico();
        mecanico.setId(1L);
        mecanico.setNombre("Carlos Boyd");
        mecanico.setEspecialidad(TipoServicio.CAMBIO_ACEITE);

        citaExistente = new Cita();
        citaExistente.setId(ambarIdCita);
        citaExistente.setMecanico(mecanico);
        citaExistente.setPlacaVehiculo("BOY-649");
        citaExistente.setTipoServicio(TipoServicio.CAMBIO_ACEITE);
        citaExistente.setFechaHoraInicio(fechaCita);
        citaExistente.setDuracionHoras(1);
        citaExistente.setEstado(EstadoCita.PROGRAMADA);

        when(proveedorFechaHora.ahora())
                .thenReturn(fechaActual);

        when(repositorioCitas.findById(ambarIdCita))
                .thenReturn(Optional.of(citaExistente));

        when(repositorioCitas.save(any(Cita.class)))
                .thenAnswer(invocacion -> invocacion.getArgument(0));
    }

    @When("cancelo la cita hoy")
    public void canceloLaCitaHoy() {

        resultadoCancelacion = servicioCitas.cancelarCita(
                citaExistente.getId()
        );
    }

    @Then("la penalidad es 0.00")
    public void laPenalidadEsCero() {

        assertNotNull(resultadoCancelacion);

        assertEquals(
                0.0,
                resultadoCancelacion.getPenalidad(),
                0.001
        );
    }

    @And("la cita queda en estado CANCELADA")
    public void laCitaQuedaEnEstadoCancelada() {

        assertEquals(
                EstadoCita.CANCELADA,
                citaExistente.getEstado()
        );

        verify(servicioNotificaciones)
                .notificarCitaCancelada(citaExistente);
    }

    // ESCENARIO 4:
    // Rechazar otra cita porque el horario está ocupado

    @Given("el mecanico ya tiene una cita programada en ese horario")
    public void elMecanicoYaTieneUnaCitaProgramadaEnEseHorario() {

        mecanico = new Mecanico();
        mecanico.setId(1L);
        mecanico.setNombre("Carlos Boyd");
        mecanico.setEspecialidad(TipoServicio.CAMBIO_ACEITE);

        fechaActual = LocalDateTime.of(2026, 9, 20, 8, 0);
        fechaCita = LocalDateTime.of(2026, 9, 21, 10, 0);

        citaExistente = new Cita();
        citaExistente.setMecanico(mecanico);
        citaExistente.setPlacaVehiculo("ABC-123");
        citaExistente.setTipoServicio(TipoServicio.CAMBIO_ACEITE);
        citaExistente.setFechaHoraInicio(fechaCita);
        citaExistente.setDuracionHoras(1);
        citaExistente.setEstado(EstadoCita.PROGRAMADA);

        when(repositorioMecanicos.findById(1L))
                .thenReturn(Optional.of(mecanico));

        when(proveedorFechaHora.ahora())
                .thenReturn(fechaActual);

        when(repositorioCitas.findByMecanicoIdAndEstado(
                1L,
                EstadoCita.PROGRAMADA
        )).thenReturn(List.of(citaExistente));
    }

    @When("intento registrar otra cita en el mismo horario")
    public void intentoRegistrarOtraCitaEnElMismoHorario() {

        String ambarPlacaSuperpuesta = "XYZ-789";

        excepcionResultado = assertThrows(
                HorarioOcupadoException.class,
                () -> servicioCitas.agendarCita(
                        1L,
                        ambarPlacaSuperpuesta,
                        TipoServicio.CAMBIO_ACEITE,
                        fechaCita
                )
        );
    }

    @Then("el servicio rechaza la cita por horario ocupado")
    public void elServicioRechazaLaCitaPorHorarioOcupado() {

        assertNotNull(excepcionResultado);

        assertEquals(
                HorarioOcupadoException.class,
                excepcionResultado.getClass()
        );
    }
}